{
  "manifest_version": 3,
  "name": "拾图 · 图片分析",
  "version": "0.1.0",
  "description": "右键使用本地增强模型或 ChatGPT（Codex CLI）分析图片。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:19428/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "拾图：在图片上右键 → 用拾图分析这张图",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
